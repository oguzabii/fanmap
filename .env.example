# Public Supabase URL (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe to expose, RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used for share links and absolute URLs
NEXT_PUBLIC_SITE_URL=https://fanmap.example

# Admin password for /admin
ADMIN_PASSWORD=change-me-please
